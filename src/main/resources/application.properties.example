# Copie este arquivo para application.properties (mesma pasta) e preencha a senha do seu MySQL.
# O application.properties fica fora do Git (.gitignore) porque guarda senha.

spring.application.name=sistema-academia

# Banco: academia_db é criado sozinho na primeira execução
spring.datasource.url=jdbc:mysql://localhost:3306/academia_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=SUA_SENHA_DO_MYSQL
# Se aparecer "Public Key Retrieval is not allowed", acrescente &allowPublicKeyRetrieval=true na URL acima

# As tabelas são criadas e atualizadas pelo Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false

# Login do administrador (padrão: admin / 123). Troque antes de usar fora do seu computador.
# gymsync.admin.usuario=admin
# gymsync.admin.senha=123

# Sessão só por cookie (não coloca ;jsessionid nos endereços)
server.servlet.session.tracking-modes=cookie

# Durante o desenvolvimento, para o HTML atualizar sem reiniciar:
# spring.thymeleaf.cache=false
