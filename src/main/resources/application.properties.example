# Copie este arquivo para application.properties (mesma pasta) e preencha a senha do seu MySQL.
# O application.properties fica fora do Git (.gitignore) porque guarda senha.

spring.application.name=sistema-academia

# Banco: academia_db é criado sozinho na primeira execução
spring.datasource.url=jdbc:mysql://localhost:3306/academia_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=SUA_SENHA_DO_MYSQL
# Se aparecer "Public Key Retrieval is not allowed", acrescente &allowPublicKeyRetrieval=true na URL acima

# As tabelas são criadas e atualizadas pelo Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false

# Login do administrador (padrão: admin / 123). Troque antes de usar fora do seu computador.
# gymsync.admin.usuario=admin
# gymsync.admin.senha=123

# Senhas fortes (ligar só na publicação): mínimo de 8 caracteres, senha provisória
# aleatória com troca obrigatória no primeiro acesso. As senhas já salvas não mudam.
# Ligado, o sistema não sobe se gymsync.admin.senha tiver menos de 8 caracteres.
# gymsync.senhas-fortes=false

# Acesso de visitante: botão "Testar como visitante" no login, só leitura. Com o banco vazio,
# cria dados de exemplo. Deixe desligado num sistema com dados reais.
# gymsync.visitante=false

# Bloqueio de login: erros seguidos por conta e por endereço de IP, e minutos de espera
# gymsync.login.max-falhas=5
# gymsync.login.max-falhas-ip=30
# gymsync.login.bloqueio-minutos=15

# Sessão só por cookie (não coloca ;jsessionid nos endereços)
server.servlet.session.tracking-modes=cookie

# Durante o desenvolvimento, para o HTML atualizar sem reiniciar:
# spring.thymeleaf.cache=false

# E-mail de suporte (Gmail), usado para enviar a ficha e o link de nova senha.
# Precisa de uma "senha de app" do Google (myaccount.google.com/apppasswords, com verificação em 2 etapas ligada).
# Para ligar: tire o # das linhas abaixo e cole a senha de app (16 letras, sem espaços).
# spring.mail.host=smtp.gmail.com
# spring.mail.port=587
# spring.mail.username=suportegymsync@gmail.com
# spring.mail.password=COLE_AQUI_A_SENHA_DE_APP
# spring.mail.properties.mail.smtp.auth=true
# spring.mail.properties.mail.smtp.starttls.enable=true
# Com o e-mail ligado, a recuperação de senha passa a mandar um link (em vez de trocar direto pelo CPF + e-mail):
# gymsync.recuperacao-por-email=true
# gymsync.url-base=http://localhost:8080

# Vídeo do "Quem somos": o código do vídeo no YouTube (11 caracteres, o que vem depois de watch?v=).
# Vazio, a seção do vídeo não aparece.
# gymsync.video-youtube=
